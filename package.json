{
  "name": "valtrix-capital",
  "version": "0.1.0",
  "private": true,
  "description": "Valtrix Capital — Web3 trading & staking platform on BSC + Polygon",
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/prisma-with-env.mjs generate",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-with-env.mjs generate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate dev",
    "db:push": "node scripts/prisma-with-env.mjs db push",
    "db:studio": "node scripts/prisma-with-env.mjs studio",
    "db:seed": "node scripts/run-with-env.mjs npx tsx prisma/seed.ts",
    "db:copy:rebuild": "node scripts/run-with-env.mjs npx tsx prisma/rebuild-copy-catalog.ts",
    "db:copy:refresh": "node scripts/run-with-env.mjs npx tsx prisma/refresh-copy-history.ts",
    "db:copy:enrich": "node scripts/run-with-env.mjs npx tsx prisma/enrich-copy-operations.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.59.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ethers": "^6.16.0",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.18",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "qr": "0.5.5",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "siwe": "^2.3.2",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.37.0",
    "wagmi": "^2.14.16",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.18",
    "google-translate-api-x": "^10.7.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
