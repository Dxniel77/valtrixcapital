// Valtrix Capital — Prisma schema
// See docs/DB_SCHEMA.md for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use the non-pooler host for migrate (advisory locks fail on -pooler)
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum Network {
  BSC
  POLYGON
}

enum Currency {
  USDT
}

enum StakeStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum StakeSource {
  ON_CHAIN
  COMPANY_SPONSORED
}

enum Direction {
  UP
  DOWN
}

enum TradeResult {
  WIN
  LOSS
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DepositPurpose {
  STAKING
  COPY
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  SENT
  CONFIRMED
  REJECTED
}

enum WithdrawalSource {
  EARNINGS
  COPY_CASH
}

enum AdminActionType {
  ACTIVATE
  DEACTIVATE
  ADJUST_BALANCE
  APPROVE_WITHDRAWAL
  REJECT_WITHDRAWAL
  RELEASE_WITHDRAWAL_ALLOWANCE
  UPDATE_CONFIG
  UPDATE_SPONSOR_TERMS
  UPDATE_USER_PROFILE
  PROCESS_ACCOUNT_DELETION
  UPDATE_SPONSORSHIP
  CREATE_IB_STRATEGY
  UPDATE_IB_STRATEGY
  ASSIGN_IB_STRATEGY
  UPSERT_IB_AGREEMENT
  IB_NET_DEPOSIT_CREDIT
  RECONCILE_HOT_WALLET_TX
}

enum HotWalletAsset {
  NATIVE
  USDT
}

enum HotWalletOutflowReviewStatus {
  IGNORED
  REGISTERED_TREASURY
}

enum SponsorTermsStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AccountDeletionStatus {
  REQUESTED
  GRACE_PERIOD
  PROCESSING
  COMPLETED
  CANCELLED
}

enum SponsorshipPeriodStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWED
  SUSPENDED
  REQUIREMENTS_MET
  REQUIREMENTS_FAILED
}

enum TreasuryDepositStatus {
  CONFIRMING
  CONFIRMED
}

enum TreasuryWithdrawalKind {
  MANUAL
  USER_PAYOUT
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  DEPOSIT
  WITHDRAWAL
  TRADING
  REFERRALS
  ACCOUNT
  OTHER
}

enum CopyRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CopyPeriod {
  TODAY
  WEEK
  MONTH
  QUARTER
  YEAR
  ALL_TIME
}

enum CopyInvestmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum CopyWithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum CopyWithdrawalMode {
  INSTANT
  APPROVAL
}

enum CopyLedgerKind {
  INVEST
  PNL
  PERFORMANCE_FEE
  PLATFORM_FEE
  WITHDRAWAL
}

enum InboxAudience {
  USER
  ADMIN
}

// ------------------------------------------------------------
// Core
// ------------------------------------------------------------

model User {
  id                  String   @id @default(uuid())
  walletAddress       String   @unique
  email               String?  @unique
  username            String?
  /// Public avatar path (e.g. /api/avatars/{id}) — IB only.
  avatarUrl           String?
  /// Compressed avatar image bytes stored in Neon (IB only).
  avatarBytes         Bytes?
  avatarMime          String?
  role                UserRole @default(USER)
  isActive            Boolean  @default(true)
  referralCode        String   @unique
  referrerId          String?
  earningsBalance     BigInt   @default(0)
  /// Idle copy-trading cash (not allocated to a trader). Instant in/out of copies.
  copyCashBalance     BigInt   @default(0)
  lockedCapital       BigInt   @default(0)
  totalEarned         BigInt   @default(0)
  payoutCap           BigInt   @default(0)
  accountGranted      Boolean  @default(false)
  withdrawalUnlocked  Boolean  @default(false)
  /// Partial USDT (micro) admin released for withdrawal while volume-locked.
  withdrawalAllowance BigInt   @default(0)
  withdrawalRule      Json?
  unlockDirectVolume  BigInt   @default(0)
  unlockLevel1Volume  BigInt   @default(0)
  unlockLevel2Volume  BigInt   @default(0)
  /// Optional IB acceleration strategy (faster path to same 200% cap).
  ibStrategyId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  referrer   User?       @relation("UserReferrer", fields: [referrerId], references: [id])
  downline   User[]      @relation("UserReferrer")
  ibStrategy IbStrategy? @relation(fields: [ibStrategyId], references: [id], onDelete: SetNull)

  stakes                  Stake[]
  trades                  Trade[]
  dailyYields             DailyYieldRecord[]
  deposits                Deposit[]
  withdrawals             Withdrawal[]
  referralsAsUser         Referral[]               @relation("ReferralUser")
  referralsAsUpline       Referral[]               @relation("ReferralUpline")
  commissionsEarned       Commission[]             @relation("CommissionBeneficiary")
  commissionsFrom         Commission[]             @relation("CommissionSource")
  adminActions            AdminAction[]            @relation("AdminActor")
  targetedActions         AdminAction[]            @relation("AdminTarget")
  inboxNotifications      InboxNotification[]
  supportTickets          SupportTicket[]
  sponsorTermsAcceptances SponsorTermsAcceptance[]
  sponsorTermsCreated     SponsorTermsVersion[]    @relation("TermsCreator")
  deletionRequest         AccountDeletionRequest?
  sponsorshipPeriods      SponsorshipPeriod[]
  copyInvestments         CopyInvestment[]
  copyWithdrawals         CopyWithdrawal[]
  deviceTokens            DeviceToken[]
  ibAgreement             IbAgreement?
  ibNetDepositCredits     IbNetDepositCredit[]     @relation("IbNetDepositBeneficiary")
  ibNetDepositSources     IbNetDepositCredit[]     @relation("IbNetDepositSource")
  hotWalletOutflowReviews HotWalletOutflowReview[] @relation("HotWalletOutflowReviewer")

  @@index([referrerId])
  @@index([walletAddress])
  @@index([ibStrategyId])
}

/// Admin-defined IB / acceleration strategy.
/// Speeds progress toward the same 2× payout cap — does not raise total investor payout.
model IbStrategy {
  id                 String   @id @default(uuid())
  name               String
  description        String   @default("")
  /// Extra passive yield bps added to platform baseYieldBps (e.g. 20 = +0.20%/day).
  passiveBonusBps    Int      @default(0)
  /// Extra trade-win bonus bps added to platform bonusPerWinBps.
  tradeBonusExtraBps Int      @default(0)
  /// Optional custom 8-level commission rates (bps) when this user earns as upline.
  /// null = use global platform commission rates.
  commissionRatesBps Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]

  @@index([isActive])
}

/// Per-user IB agreement (Net Deposit negotiation). Kept separate from IbStrategy yield boost.
model IbAgreement {
  id                String   @id @default(uuid())
  userId            String   @unique
  /// Visible as IB in admin monitor even if Net Deposit is temporarily off.
  isIb              Boolean  @default(true)
  netDepositEnabled Boolean  @default(false)
  /// % of L1 (direct) referral deposits in bps (300 = 3%).
  level1DepositBps  Int      @default(0)
  /// % of L2 deposits in bps; 0 = L1 only.
  level2DepositBps  Int      @default(0)
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits IbNetDepositCredit[]

  @@index([isIb])
  @@index([netDepositEnabled])
}

/// One Net Deposit bonus per (IB, deposit). Real on-chain deposits only.
model IbNetDepositCredit {
  id             String   @id @default(uuid())
  beneficiaryId  String
  sourceUserId   String
  depositId      String
  agreementId    String?
  level          Int
  rateBps        Int
  depositAmount  BigInt
  creditedAmount BigInt
  createdAt      DateTime @default(now())

  beneficiary User         @relation("IbNetDepositBeneficiary", fields: [beneficiaryId], references: [id])
  sourceUser  User         @relation("IbNetDepositSource", fields: [sourceUserId], references: [id])
  deposit     Deposit      @relation(fields: [depositId], references: [id])
  agreement   IbAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  @@unique([beneficiaryId, depositId])
  @@index([beneficiaryId, createdAt])
  @@index([depositId])
  @@index([sourceUserId])
}

model Stake {
  id          String      @id @default(uuid())
  userId      String
  amount      BigInt
  network     Network
  currency    Currency    @default(USDT)
  depositId   String?     @unique
  source      StakeSource @default(ON_CHAIN)
  status      StakeStatus @default(ACTIVE)
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  user    User     @relation(fields: [userId], references: [id])
  deposit Deposit? @relation(fields: [depositId], references: [id])

  @@index([userId])
  @@index([status])
}

model Trade {
  id                   String       @id @default(uuid())
  userId               String
  pair                 String
  direction            Direction
  entryPrice           Decimal      @db.Decimal(20, 8)
  exitPrice            Decimal?     @db.Decimal(20, 8)
  durationSec          Int
  openedAt             DateTime     @default(now())
  resolvedAt           DateTime?
  result               TradeResult?
  bonusAppliedBps      Int          @default(0)
  capitalSnapshotAtWin BigInt       @default(0)
  bonusCredited        BigInt       @default(0)

  user        User         @relation(fields: [userId], references: [id])
  commissions Commission[]

  @@index([userId, openedAt])
  @@index([userId, result])
}

model DailyYieldRecord {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  baseRateBps     Int      @default(30)
  winsCount       Int      @default(0)
  bonusRateBps    Int      @default(0)
  totalRateBps    Int
  capitalSnapshot BigInt
  creditedAmount  BigInt
  createdAt       DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  commissions Commission[]

  @@index([userId, date])
  @@index([date])
}

model Referral {
  id        String   @id @default(uuid())
  userId    String
  uplineId  String
  level     Int
  createdAt DateTime @default(now())

  user   User @relation("ReferralUser", fields: [userId], references: [id])
  upline User @relation("ReferralUpline", fields: [uplineId], references: [id])

  @@unique([userId, level])
  @@index([uplineId, level])
}

model Commission {
  id            String   @id @default(uuid())
  beneficiaryId String
  sourceUserId  String
  level         Int
  rateBps       Int
  amount        BigInt
  sourceYieldId String?
  sourceTradeId String?
  /// Copy Performance Fee ledger row this network share was paid from.
  sourceCopyLedgerId String?
  createdAt     DateTime @default(now())

  beneficiary User                  @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id])
  sourceUser  User                  @relation("CommissionSource", fields: [sourceUserId], references: [id])
  sourceYield DailyYieldRecord?     @relation(fields: [sourceYieldId], references: [id])
  sourceTrade Trade?                @relation(fields: [sourceTradeId], references: [id])
  copyLedger  CopyInvestmentLedger? @relation(fields: [sourceCopyLedgerId], references: [id], onDelete: SetNull)

  @@unique([beneficiaryId, sourceCopyLedgerId, level])
  @@index([beneficiaryId])
  @@index([sourceUserId])
  @@index([sourceTradeId])
  @@index([sourceCopyLedgerId])
}

model Deposit {
  id            String    @id @default(uuid())
  userId        String
  network       Network
  currency      Currency  @default(USDT)
  amount        BigInt
  fromAddress   String
  toAddress     String
  txHash        String    @unique
  confirmations Int       @default(0)
  status        TxStatus  @default(PENDING)
  detectedAt    DateTime  @default(now())
  confirmedAt   DateTime?
  /// STAKING credits locked capital. COPY credits idle copy cash.
  purpose       DepositPurpose @default(STAKING)

  user                User                 @relation(fields: [userId], references: [id])
  stake               Stake?
  ibNetDepositCredits IbNetDepositCredit[]

  @@index([userId])
}

model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  network     Network
  currency    Currency         @default(USDT)
  amount      BigInt
  fee         BigInt
  netAmount   BigInt
  toAddress   String
  source      WithdrawalSource @default(EARNINGS)
  status      WithdrawalStatus @default(REQUESTED)
  txHash      String?
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  user           User                @relation(fields: [userId], references: [id])
  treasuryPayout TreasuryWithdrawal?

  @@index([userId, status])
}

model BotOperation {
  id         String    @id @default(uuid())
  pair       String
  direction  Direction
  volume     BigInt
  pnl        BigInt
  pnlBps     Int
  fakeTxHash String    @unique
  network    Network
  executedAt DateTime  @default(now())

  @@index([executedAt])
}

model AdminAction {
  id           String          @id @default(uuid())
  adminId      String
  targetUserId String?
  action       AdminActionType
  payload      Json
  createdAt    DateTime        @default(now())

  admin  User  @relation("AdminActor", fields: [adminId], references: [id])
  target User? @relation("AdminTarget", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
}

model TreasuryState {
  id             Int      @id @default(1)
  bscBalance     BigInt   @default(0)
  polygonBalance BigInt   @default(0)
  updatedAt      DateTime @updatedAt
}

model TreasuryDeposit {
  id                    String                @id @default(uuid())
  network               Network
  amount                BigInt
  txHash                String                @unique
  confirmations         Int                   @default(0)
  requiredConfirmations Int
  status                TreasuryDepositStatus @default(CONFIRMING)
  recordedBy            String?
  startedAt             DateTime              @default(now())
  confirmedAt           DateTime?

  @@index([status, startedAt(sort: Desc)])
}

model TreasuryWithdrawal {
  id               String                 @id @default(uuid())
  network          Network
  amount           BigInt
  toAddress        String
  txHash           String?
  note             String                 @default("")
  kind             TreasuryWithdrawalKind @default(MANUAL)
  userWithdrawalId String?                @unique
  createdBy        String?
  createdAt        DateTime               @default(now())

  userWithdrawal Withdrawal? @relation(fields: [userWithdrawalId], references: [id])

  @@index([createdAt(sort: Desc)])
}

model AppConfig {
  id                 Int      @id @default(1)
  baseYieldBps       Int      @default(30)
  bonusPerWinBps     Int      @default(10)
  maxTradesPerDay    Int      @default(7)
  maxDailyYieldBps   Int      @default(100)
  withdrawalFeeBps   Int      @default(400)
  commissionRatesBps Int[]    @default([2000, 1000, 1000, 1000, 500, 500, 500, 500])
  minStake           BigInt   @default(15000000)
  maxStake           BigInt   @default(100000000000)
  minWithdrawal      BigInt   @default(1000000)
  allowedPairs       String[] @default(["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "BNBUSDT", "MATICUSDT"])
  updatedAt          DateTime @updatedAt
}

// SIWE nonces for sign-in
model AuthNonce {
  id        String   @id @default(uuid())
  nonce     String   @unique
  address   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([address])
  @@index([expiresAt])
}

model PlatformBroadcast {
  id        String   @id @default(uuid())
  kind      String
  title     String
  body      String
  href      String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model SupportTicket {
  id        String                @id
  userId    String?
  name      String
  email     String
  wallet    String?
  category  SupportTicketCategory
  subject   String
  message   String
  status    SupportTicketStatus   @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user        User?                     @relation(fields: [userId], references: [id])
  replies     SupportTicketReply[]
  attachments SupportTicketAttachment[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([wallet])
  @@index([email])
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  body      String
  isStaff   Boolean  @default(true)
  adminId   String?
  createdAt DateTime @default(now())

  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
}

model SupportTicketAttachment {
  id             String   @id @default(uuid())
  ticketId       String?
  replyId        String?
  uploaderWallet String
  fileName       String
  mimeType       String
  sizeBytes      Int
  data           Bytes
  createdAt      DateTime @default(now())

  ticket SupportTicket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reply  SupportTicketReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([replyId])
}

model InboxNotification {
  id        String        @id @default(uuid())
  audience  InboxAudience
  userId    String?
  wallet    String?
  email     String?
  kind      String
  eventKey  String
  params    Json          @default("{}")
  href      String?
  dedupeKey String        @unique
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([audience, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([wallet, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
}

model SponsorTermsVersion {
  id          String             @id @default(uuid())
  version     Int
  title       String
  content     String             @db.Text
  status      SponsorTermsStatus @default(DRAFT)
  effectiveAt DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy   User                     @relation("TermsCreator", fields: [createdById], references: [id])
  acceptances SponsorTermsAcceptance[]

  @@unique([version])
  @@index([status, effectiveAt(sort: Desc)])
}

model SponsorTermsAcceptance {
  id             String   @id @default(uuid())
  userId         String
  termsVersionId String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?

  user         User                @relation(fields: [userId], references: [id])
  termsVersion SponsorTermsVersion @relation(fields: [termsVersionId], references: [id])

  @@unique([userId, termsVersionId])
  @@index([userId])
  @@index([termsVersionId])
}

model AccountDeletionRequest {
  id            String                @id @default(uuid())
  userId        String                @unique
  status        AccountDeletionStatus @default(REQUESTED)
  reason        String?
  requestedAt   DateTime              @default(now())
  scheduledFor  DateTime?
  processedAt   DateTime?
  processedById String?

  user User @relation(fields: [userId], references: [id])

  @@index([status, requestedAt(sort: Desc)])
}

model SponsorshipDurationRule {
  id             String   @id @default(uuid())
  minAmountMicro BigInt
  durationDays   Int
  label          String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  periods SponsorshipPeriod[]

  @@index([isActive, minAmountMicro(sort: Desc)])
}

model SponsorshipPeriod {
  id                String                  @id @default(uuid())
  userId            String
  ruleId            String?
  amountMicro       BigInt
  startDate         DateTime                @default(now())
  endDate           DateTime
  status            SponsorshipPeriodStatus @default(ACTIVE)
  requirementsMetAt DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user User                     @relation(fields: [userId], references: [id])
  rule SponsorshipDurationRule? @relation(fields: [ruleId], references: [id])

  @@index([userId, status])
  @@index([endDate])
  @@index([status, endDate])
}

// ------------------------------------------------------------
// Copy Trading (Weeks 6–9)
// ------------------------------------------------------------

model CopyTrader {
  id                      String        @id
  name                    String
  photoUrl                String?
  description             String        @db.Text
  countryCode             String?       @db.VarChar(2)
  countryName             String?
  riskLevel               CopyRiskLevel @default(MEDIUM)
  experienceDays          Int           @default(0)
  profitDays              Int           @default(0)
  followersCount          Int           @default(0)
  investorsCount          Int           @default(0)
  aum                     BigInt        @default(0)
  totalInvested           BigInt        @default(0)
  roiBps                  Int           @default(0)
  cumulativeRoiBps        Int           @default(0)
  winRateBps              Int           @default(0)
  maxDrawdownBps          Int           @default(0)
  tradeVolume             BigInt        @default(0)
  winningTrades           Int           @default(0)
  losingTrades            Int           @default(0)
  minInvestment           BigInt        @default(15000000)
  /// Profit-share / performance fee shown to clients (bps, 3000 = 30%).
  performanceFeeBps       Int           @default(3000)
  /// Max real investors allowed to copy this trader.
  maxInvestors            Int           @default(180)
  /// Public copier-list target. Real copiers are shown first; stable showcase rows fill the gap.
  showcaseCopiers         Int           @default(0)
  isActive                Boolean       @default(true)
  isVisible               Boolean       @default(true)
  isFeatured              Boolean       @default(false)
  sortOrder               Int           @default(0)
  simulationEnabled       Boolean       @default(false)
  simulationMinBps        Int           @default(-50)
  simulationMaxBps        Int           @default(100)
  simulationIntervalHours Int           @default(24)
  /// Daily live-operation range (UTC day).
  simulationMinOpsPerDay  Int           @default(8)
  simulationMaxOpsPerDay  Int           @default(20)
  /// Open duration range in minutes.
  simulationDurationMinMinutes Int      @default(3)
  simulationDurationMaxMinutes Int      @default(10)
  /// Persisted UTC day plan so restarts do not redraw the schedule.
  simulationOpsDayKey     String?
  simulationOpsToday      Int           @default(0)
  simulationOpsTarget     Int           @default(0)
  simulationLastRunAt     DateTime?
  simulationNextRunAt     DateTime?
  /// Admin-only next OPEN time. Never expose to users.
  nextOperationAt         DateTime?
  /// Share of winner-role ops that close green (bps, 6000 = 60%).
  winProbBps              Int           @default(6000)
  /// Share of loser-role ops that close red (bps, 4000 = 40%).
  lossProbBps             Int           @default(4000)
  /// When true, live ops bias toward monthlyTargetBps over targetCycleDays.
  targetMode              Boolean       @default(false)
  monthlyTargetBps        Int           @default(0)
  targetCycleDays         Int           @default(30)
  targetCycleStartedAt    DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  performances      CopyTraderPerformance[]
  performanceEvents CopyPerformanceEvent[]
  operations        CopyTraderOperation[]
  chartPoints       CopyTraderChartPoint[]
  investments              CopyInvestment[]
  scheduledManualResults   CopyScheduledManualResult[]

  @@index([isVisible, isActive, sortOrder])
  @@index([roiBps])
  @@index([simulationEnabled, simulationNextRunAt])
  @@index([simulationEnabled, nextOperationAt])
}

model CopyTraderPerformance {
  id        String     @id @default(uuid())
  traderId  String
  period    CopyPeriod
  returnBps Int
  updatedAt DateTime   @updatedAt

  trader CopyTrader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, period])
}

model CopyPerformanceEvent {
  id             String     @id @default(uuid())
  traderId       String
  period         CopyPeriod @default(TODAY)
  returnBps      Int
  source         String     @default("ADMIN")
  idempotencyKey String     @unique
  createdById    String?
  createdAt      DateTime   @default(now())

  trader    CopyTrader           @relation(fields: [traderId], references: [id], onDelete: Cascade)
  operation CopyTraderOperation?

  @@index([traderId, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
}

model CopyTraderOperation {
  id                 String   @id @default(uuid())
  traderId           String
  symbol             String
  direction          String
  leverage           Int
  entryPrice         Decimal  @db.Decimal(20, 8)
  targetReturnBps    Int
  exitPrice          Decimal? @db.Decimal(20, 8)
  settledReturnBps   Int?
  status             String   @default("OPEN")
  openKey            String?  @unique
  idempotencyKey     String   @unique
  performanceEventId String?  @unique
  openedAt           DateTime @default(now())
  closesAt           DateTime
  closedAt           DateTime?
  createdAt          DateTime @default(now())
  /// Sum of copier platform fees charged at open (0.05% of notional).
  platformFeeMicro   BigInt   @default(0)
  /// Sum of copier Performance Fees charged at close (profit only).
  performanceFeeMicro BigInt  @default(0)
  /// Sum of copier gross P&L at close, before the Performance Fee.
  grossPnlMicro      BigInt   @default(0)
  /// Showcase/history only. Never settles copier balances or company fees.
  synthetic          Boolean  @default(false)

  trader           CopyTrader            @relation(fields: [traderId], references: [id], onDelete: Cascade)
  performanceEvent CopyPerformanceEvent? @relation(fields: [performanceEventId], references: [id], onDelete: SetNull)

  @@index([traderId, status, openedAt(sort: Desc)])
  @@index([status, closesAt])
  @@index([traderId, synthetic, closedAt])
}

model CopyTraderChartPoint {
  id        String   @id @default(uuid())
  traderId  String
  date      DateTime @db.Date
  valueBps  Int
  createdAt DateTime @default(now())

  trader CopyTrader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, date])
  @@index([traderId, date])
}

model CopyInvestment {
  id           String               @id @default(uuid())
  userId       String
  traderId     String
  principal    BigInt
  currentValue BigInt
  realizedPnl  BigInt               @default(0)
  status       CopyInvestmentStatus @default(ACTIVE)
  startedAt    DateTime             @default(now())
  closedAt     DateTime?

  user        User                   @relation(fields: [userId], references: [id])
  trader      CopyTrader             @relation(fields: [traderId], references: [id])
  ledger      CopyInvestmentLedger[]
  withdrawals CopyWithdrawal[]

  @@index([userId, status])
  @@index([traderId, status])
}

model CopyInvestmentLedger {
  id            String         @id @default(uuid())
  investmentId  String
  kind          CopyLedgerKind
  amount        BigInt
  balanceAfter  BigInt
  performanceId String?
  note          String?
  createdAt     DateTime       @default(now())

  investment CopyInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  networkCommissions Commission[]

  @@index([investmentId, createdAt])
}

model CopyWithdrawal {
  id            String               @id @default(uuid())
  investmentId  String
  userId        String
  amount        BigInt
  status        CopyWithdrawalStatus @default(REQUESTED)
  requestedAt   DateTime             @default(now())
  processedAt   DateTime?
  processedById String?

  investment CopyInvestment @relation(fields: [investmentId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, requestedAt])
}

model CopyTradingConfig {
  id                  Int                @id @default(1)
  globalMinInvestment BigInt             @default(15000000)
  withdrawalMode      CopyWithdrawalMode @default(INSTANT)
  notifyOnPerformance Boolean            @default(true)
  /// Fee taken from the amount when starting a copy (bps, 100 = 1%).
  investFeeBps        Int                @default(100)
  /// Fee when leaving a copy back to copy cash (bps). 0 = free.
  withdrawFeeBps      Int                @default(0)
  /// Fee when withdrawing copy cash to an on-chain wallet (bps, 3 = 0.03%).
  copyCashWalletFeeBps Int               @default(3)
  /// Unused. Kept so existing databases do not need a destructive migration.
  settlementCutoffHour Int               @default(22)
  /// Unused. Kept so existing databases do not need a destructive migration.
  lossGraceDays       Int                @default(2)
  /// Six-level share of each copier's Performance Fee (bps of the fee). Remainder stays with the company.
  performanceFeeNetworkBps Int[]         @default([3000, 1500, 1000, 500, 500, 500])
  /// Platform fee charged when a live operation opens (bps of the copier's capital, not leverage). 5 = 0.05%.
  openFeeBps          Int                @default(5)
  /// Symbols the live engine may open. At least one is required.
  activeSymbols       String[]           @default(["BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT", "XRPUSDT", "ADAUSDT", "DOGEUSDT", "TRXUSDT", "LINKUSDT", "AVAXUSDT"])
  updatedAt           DateTime           @updatedAt
}

/// Admin-only delayed showcase result. Does not move copier balances.
model CopyScheduledManualResult {
  id          String    @id @default(uuid())
  traderId    String
  returnBps   Int
  executeAt   DateTime
  createdById String
  createdAt   DateTime  @default(now())
  canceledAt  DateTime?
  executedAt  DateTime?

  trader CopyTrader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([executeAt, canceledAt, executedAt])
  @@index([traderId, executeAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin review of an on-chain hot-wallet outflow that was missing from Valtrix records.
model HotWalletOutflowReview {
  id           String                       @id @default(uuid())
  network      Network
  asset        HotWalletAsset
  txHash       String
  fromAddress  String
  toAddress    String
  amount       Float
  amountUsd    Float
  status       HotWalletOutflowReviewStatus
  note         String                       @default("")
  reviewedById String?
  reviewedAt   DateTime                     @default(now())
  createdAt    DateTime                     @default(now())

  reviewedBy User? @relation("HotWalletOutflowReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([network, txHash])
  @@index([reviewedAt(sort: Desc)])
  @@index([status])
}
