# --- Database (required in production) ---
# Neon: use the *-pooler* host for the app, and the non-pooler host for DIRECT_URL
# (Prisma migrate needs directUrl for advisory locks).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Persist admin notification broadcasts to Postgres (set true in production).
BROADCAST_USE_DATABASE="true"
# Protect cron endpoints — set a long random secret in production.
CRON_SECRET=""

# --- Yield testing cadence (optional — revert to 86400000 / daily cron after QA) ---
# PASSIVE_YIELD_DELAY_MS=600000
# YIELD_ACCRUAL_INTERVAL_MS=600000

# --- NextAuth (required in production) ---
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="https://your-production-domain.com"

# --- Admin managers (comma-separated; server-only, never NEXT_PUBLIC_) ---
ADMIN_WALLETS="0xManagerWallet1...,0xManagerWallet2..."

# --- Web3 (public) ---
# Required for mobile wallets (WalletConnect). Create a free project at https://cloud.walletconnect.com
# and add your production domain under Allowed Domains.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="230340398c029a215eda20063db1cdc6"
NEXT_PUBLIC_BSC_RPC="https://bsc-dataseed.binance.org"
NEXT_PUBLIC_POLYGON_RPC="https://polygon-bor-rpc.publicnode.com"
NEXT_PUBLIC_APP_NAME="Valtrix Capital"
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# --- Treasury deposit addresses (public — shown on deposit UI; REQUIRED in production) ---
# Must be real funded wallets — NOT 0x000… placeholders.
NEXT_PUBLIC_TREASURY_BSC_ADDRESS="0xYourBscTreasuryWallet..."
NEXT_PUBLIC_TREASURY_POLYGON_ADDRESS="0xYourPolygonTreasuryWallet..."

# --- Copy-trading deposit addresses (public — shown on copy deposit UI) ---
# Separate hot wallet from staking so copy deposits/payouts do not mix with yield liquidity.
NEXT_PUBLIC_COPY_BSC_ADDRESS="0xYourCopyBscWallet..."
NEXT_PUBLIC_COPY_POLYGON_ADDRESS="0xYourCopyPolygonWallet..."

# --- Automatic withdrawal payout (server-only — NEVER expose publicly) ---
# Private key of the treasury hot wallet that holds USDT + gas for payouts.
TREASURY_PAYOUT_PRIVATE_KEY=""
# Optional per-network overrides:
# TREASURY_BSC_PAYOUT_PRIVATE_KEY=""
# TREASURY_POLYGON_PAYOUT_PRIVATE_KEY=""
# Copy-cash payouts — never reuse TREASURY_PAYOUT_PRIVATE_KEY here.
COPY_PAYOUT_PRIVATE_KEY=""
# COPY_BSC_PAYOUT_PRIVATE_KEY=""
# COPY_POLYGON_PAYOUT_PRIVATE_KEY=""
# Optional server-side RPC overrides (defaults to NEXT_PUBLIC_* RPC URLs):
# BSC_RPC=""
# POLYGON_RPC=""

# --- Exchange APIs (optional) ---
BINANCE_REST_BASE=""
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# --- Block Explorers (recommended for deposit/payout monitoring) ---
# Create a key at https://etherscan.io/apidashboard (Polygon chainid=137 is free; BSC is paid).
ETHERSCAN_API_KEY=""
BSCSCAN_API_KEY=""
POLYGONSCAN_API_KEY=""
# Optional dedicated RPC for hot-wallet USDT outflow logs (BSC). Binance dataseed often rejects getLogs.
# BSC_LOGS_RPC="https://rpc-bsc.48.club"

# --- Email (recommended in production) ---
RESEND_API_KEY=""
RESEND_FROM="Valtrix Capital <noreply@your-domain.com>"

# --- Errors (optional) ---
SENTRY_DSN=""

# Production readiness: GET /api/health returns configIssues when NODE_ENV=production.
