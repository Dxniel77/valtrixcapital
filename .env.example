# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/valtrix?schema=public"
# Persist admin notification broadcasts to Postgres (set true in production).
BROADCAST_USE_DATABASE="true"
# Protect cron endpoints (optional in dev)
CRON_SECRET=""

# --- NextAuth ---
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin managers (comma-separated; server-only, never NEXT_PUBLIC_) ---
ADMIN_WALLETS="0xManagerWallet1...,0xManagerWallet2..."

# --- Web3 (public) ---
# Required for mobile wallets (WalletConnect). Create a free project at https://cloud.walletconnect.com
# and add your production domain (e.g. valtrix-capital.vercel.app) under Allowed Domains.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="230340398c029a215eda20063db1cdc6"
NEXT_PUBLIC_BSC_RPC="https://bsc-dataseed.binance.org"
NEXT_PUBLIC_POLYGON_RPC="https://polygon-bor-rpc.publicnode.com"
NEXT_PUBLIC_APP_NAME="Valtrix Capital"
NEXT_PUBLIC_APP_URL="https://valtrix-capital.vercel.app"

# --- Treasury (public — shown on deposit UI) ---
NEXT_PUBLIC_TREASURY_BSC_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_TREASURY_POLYGON_ADDRESS="0x0000000000000000000000000000000000000000"

# --- Exchange APIs (provided by client) ---
# Optional override for server-side market data (defaults to data-api.binance.vision)
BINANCE_REST_BASE=""
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# --- Block Explorers (Etherscan API v2 — one key for BSC, Polygon, etc.) ---
# Create a key at https://etherscan.io/apidashboard
# BSC uses chainid=56, Polygon uses chainid=137 (no separate Polygonscan key needed).
ETHERSCAN_API_KEY=""
# Legacy names still supported as fallbacks:
BSCSCAN_API_KEY=""
POLYGONSCAN_API_KEY=""

# --- Email / Errors (optional in dev) ---
RESEND_API_KEY=""
SENTRY_DSN=""
